# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional. Raises Socrata rate limits. Create one at https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Two-day reproducible slice. Set SAMPLE_ROWS=0 to take the entire window.
# Full 2020-present is tens of millions of rows. Widen the dates only after the sample run works.
START_DATE=2025-06-01
END_DATE=2025-06-03
SAMPLE_ROWS=20000
SODA_PAGE_SIZE=50000

SPARK_DRIVER_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=8
